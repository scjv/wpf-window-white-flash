<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Same as DarkStartupMinimal and the production app: Fluent controls without the Mica backdrop
         (the "mica" mode turns it back on at runtime). -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
